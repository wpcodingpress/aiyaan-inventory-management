generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logo            String?
  favicon         String?
  primaryColor    String    @default("#4f46e5")
  secondaryColor  String    @default("#565e74")
  currency        String    @default("BDT")
  currencySymbol  String    @default("৳")
  timezone        String    @default("Asia/Dhaka")
  dateFormat      String    @default("DD/MM/YYYY")
  businessType    String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  isActive        Boolean   @default(true)
  r2Provider      String    @default("Cloudflare R2")
  r2AccountId     String?
  r2AccessKeyId   String?
  r2SecretAccessKey String?
  r2BucketName    String?
  r2PublicUrl     String?
  r2Connected     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users           User[]
  roles           Role[]
  products        Product[]
  categories      Category[]
  brands          Brand[]
  suppliers       Supplier[]
  customers       Customer[]
  purchases       Purchase[]
  sales           Sale[]
  expenses        Expense[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]
  settings        Setting[]

  @@map("organizations")
}

model User {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  email           String    @unique
  password        String?
  image           String?
  role            String    @default("viewer")
  status          String    @default("active")
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs       AuditLog[]

  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  permissions     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("roles")
}

model Category {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([organizationId, slug])
  @@map("categories")
}

model Brand {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  logo            String?
  description     String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([organizationId, slug])
  @@map("brands")
}

model Product {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  slug             String
  description      String?
  categoryId       String?
  brandId          String?
  image            String?
  sku              String
  barcode          String?
  status           String    @default("active")
  lowStockThreshold Int      @default(10)
  trackInventory   Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category?    @relation(fields: [categoryId], references: [id])
  brand            Brand?       @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id              String    @id @default(uuid())
  productId       String
  sku             String
  barcode         String?
  size            String?
  color           String?
  material        String?
  purchaseCost    Decimal   @db.Decimal(12,2)
  sellingPrice    Decimal   @db.Decimal(12,2)
  minimumStock    Int       @default(0)
  currentStock    Int       @default(0)
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements  StockMovement[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]

  @@unique([sku])
  @@index([productId])
  @@map("product_variants")
}

model Supplier {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  slug            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  taxId           String?
  paymentTerms    String?
  rating          Decimal   @default(0) @db.Decimal(3,2)
  status          String    @default("active")
  isActive        Boolean   @default(true)
  totalPurchases  Int       @default(0)
  totalSpent      Decimal   @default(0) @db.Decimal(12,2)
  outstandingBalance Decimal @default(0) @db.Decimal(12,2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases       Purchase[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  customerType    String    @default("individual")
  isActive        Boolean   @default(true)
  totalSpent      Decimal   @default(0) @db.Decimal(12,2)
  totalSales      Int       @default(0)
  outstandingBalance Decimal @default(0) @db.Decimal(12,2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales           Sale[]

  @@index([organizationId])
  @@map("customers")
}

model Purchase {
  id              String    @id @default(uuid())
  organizationId  String
  supplierId      String?
  purchaseNumber  String
  invoiceNumber   String?
  purchaseDate    DateTime
  subtotal        Decimal   @db.Decimal(12,2)
  discount        Decimal   @default(0) @db.Decimal(12,2)
  tax             Decimal   @default(0) @db.Decimal(12,2)
  total           Decimal   @db.Decimal(12,2)
  paidAmount      Decimal   @default(0) @db.Decimal(12,2)
  dueAmount       Decimal   @default(0) @db.Decimal(12,2)
  paymentStatus   String    @default("unpaid")
  status          String    @default("draft")
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier?    @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id              String    @id @default(uuid())
  purchaseId      String
  productId       String?
  variantId       String?
  quantity        Int
  unitCost        Decimal   @db.Decimal(12,2)
  discount        Decimal   @default(0) @db.Decimal(12,2)
  tax             Decimal   @default(0) @db.Decimal(12,2)
  total           Decimal   @db.Decimal(12,2)

  purchase        Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

model Sale {
  id              String    @id @default(uuid())
  organizationId  String
  customerId      String?
  saleNumber      String
  saleDate        DateTime
  subtotal        Decimal   @db.Decimal(12,2)
  discount        Decimal   @default(0) @db.Decimal(12,2)
  tax             Decimal   @default(0) @db.Decimal(12,2)
  total           Decimal   @db.Decimal(12,2)
  paidAmount      Decimal   @default(0) @db.Decimal(12,2)
  dueAmount       Decimal   @default(0) @db.Decimal(12,2)
  paymentStatus   String    @default("unpaid")
  status          String    @default("completed")
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id])
  items           SaleItem[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id              String    @id @default(uuid())
  saleId          String
  productId       String?
  variantId       String?
  quantity        Int
  sellingPrice    Decimal   @db.Decimal(12,2)
  costAtSale      Decimal   @db.Decimal(12,2)
  discount        Decimal   @default(0) @db.Decimal(12,2)
  tax             Decimal   @default(0) @db.Decimal(12,2)
  total           Decimal   @db.Decimal(12,2)
  profit          Decimal   @default(0) @db.Decimal(12,2)

  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

model Expense {
  id              String    @id @default(uuid())
  organizationId  String
  category        String
  title           String
  amount          Decimal   @db.Decimal(12,2)
  date            DateTime
  paymentMethod   String?
  reference       String?
  notes           String?
  attachment      String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([date])
  @@map("expenses")
}

model StockMovement {
  id              String    @id @default(uuid())
  organizationId  String
  variantId       String
  movementType    String
  quantity        Int
  unitCost        Decimal   @db.Decimal(12,2)
  totalCost       Decimal   @db.Decimal(12,2)
  balanceAfter    Int
  referenceType   String?
  referenceId     String?
  note            String?
  createdBy       String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId])
  @@index([variantId])
  @@index([createdAt])
  @@index([movementType])
  @@map("stock_movements")
}

model AuditLog {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String?
  action          String
  entityType      String
  entityId        String?
  metadata        String?
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Setting {
  id              String    @id @default(uuid())
  organizationId  String
  key             String
  value           String
  category        String    @default("general")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("settings")
}
