# MIKU — environment variables (never commit real values)
# Copy these into your host's environment (Render, Vercel, …).

# Required — your Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required — protects the /api/miku/ingest endpoint (use a long random string)
MIKU_INGEST_SECRET=

# Optional — Groq backup provider
GROQ_API_KEY=

# Database where MIKU stores its knowledge index (four miku_* tables)
MIKU_DB_URL=postgresql://user:password@host:5432/database
MIKU_DB_SSL=1
